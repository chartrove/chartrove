{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardApproval": true,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "automerge": false,
  "packageRules": [
    {
      "description": "The desktop backend and provider original-module versions are overridden by intentional local/provenance replacements; review replacements explicitly.",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/fastenhealth/fasten-onprem",
        "github.com/fastenhealth/fasten-sources"
      ],
      "enabled": false
    }
  ]
}
